# ===== 运行环境 =====
APP_ENV=local                  # local | staging | production
APP_HOST=127.0.0.1             # local 默认仅本机；真机联调需局域网访问时才改为 0.0.0.0
APP_PORT=8090
LOG_LEVEL=debug                # debug | info | warn | error
MIN_APP_VERSION=0.0.0          # WS hello min_app_version (MAJOR.MINOR.PATCH)

# ===== 数据库 / 缓存（必填）=====
DATABASE_URL=postgres://petbridge:petbridge@localhost:5432/petbridge?sslmode=disable
TEST_DATABASE_URL=postgres://petbridge:petbridge@localhost:5432/petbridge_test?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# ===== 登录与令牌 =====
JWT_SIGNING_KEY=local-dev-only-change-me   # 必填；非 local 环境必须 >=32 位随机密钥
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
DEV_LOGIN_ENABLED=true                     # 仅 local 允许为 true

# ===== AI 网关（B1 不使用，留空/默认即可）=====
AI_PROVIDER=fake                           # fake | live
FAKE_AI_LATENCY_MS=300
FAKE_AI_FAIL_RATE=0
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL_TRANSLATE=
LLM_PRIMARY_MODEL_POLISH=
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_API_KEY=
MT_FALLBACK_API_KEY=
AI_DAILY_BUDGET_USD=5
AI_POLISH_DAILY_QUOTA=30

# ===== 推送 / 监控（B1 不使用，留空）=====
FCM_CREDENTIALS_FILE=
SENTRY_DSN=

# ===== 对象存储：B1 不使用，留空即可 =====
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ===== 业务默认值（运行后以 app_config 表为准）=====
ROOM_CAPACITY=5                            # 每间小屋座位数（含房主），2-5；只影响之后新建的小屋
CODE_TTL_DAYS=7
REWARD_CODE_COUNT=3                        # 加入成功后给新成员的奖励邀请码数量，0-5（0 = 不发）
REWARD_CODE_LIFETIME_CAP=20                # 每人一生最多获得的奖励邀请码数，>=1
OWNER_REGEN_DAILY_LIMIT=3                  # 房主每日重新生成邀请码次数上限，>=1
